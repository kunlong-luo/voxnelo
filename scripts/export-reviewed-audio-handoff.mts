#!/usr/bin/env node
/**
 * Deterministic reviewer planning sheet: no audio read, recording, network,
 * reviewer identity, permission or sign-off is generated by this script.
 */
import { connectedSpeechAudioHandoffCsv } from '../packages/content/connected-speech-audio-handoff.ts';

if (process.argv.length !== 2) {
  process.stderr.write('Usage: pnpm --silent content:audio:handoff:export > audio-handoff.csv\n');
  process.exitCode = 2;
} else {
  process.stdout.write(connectedSpeechAudioHandoffCsv());
}
