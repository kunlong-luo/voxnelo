{
  "name": "voxnelo",
  "private": true,
  "version": "0.1.0",
  "description": "Voxnelo — 桌面优先、本地优先的免费英语口语练习应用（V0.1 Early Access）",
  "author": "Voxnelo",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm dev:renderer\" \"pnpm dev:desktop\"",
    "dev:renderer": "pnpm worklet:build && rsbuild dev --host 127.0.0.1 --port 3000",
    "dev:desktop": "pnpm build:electron && wait-on http://127.0.0.1:3000 && cross-env VOXNELO_DEV_SERVER_URL=http://127.0.0.1:3000 electron . --disable-gpu-sandbox",
    "dev:web": "pnpm worklet:build && rsbuild dev --host 127.0.0.1 --port 3000",
    "build": "pnpm build:renderer && pnpm build:electron",
    "build:renderer": "pnpm worklet:build && rsbuild build",
    "build:electron": "node --experimental-strip-types scripts/check-asr-staging.mts && node --experimental-strip-types scripts/build-electron.mts",
    "asr:check-staging": "node --experimental-strip-types scripts/check-asr-staging.mts",
    "asr:model:prepare": "node --experimental-strip-types scripts/prepare-asr-model.mts",
    "asr:native:stage": "node --experimental-strip-types scripts/stage-asr-native.mts",
    "asr:verify-real": "node --experimental-strip-types scripts/check-asr-real-release.mts",
    "worklet:build": "node --experimental-strip-types scripts/build-audio-worklet.mts",
    "typecheck": "tsc --noEmit",
    "lint": "node --experimental-strip-types ./node_modules/eslint/bin/eslint.js --flag unstable_native_nodejs_ts_config . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "depcruise --validate .dependency-cruiser.json apps packages tests",
    "check:stable-deps": "node --experimental-strip-types scripts/check-stable-dependencies.mts",
    "perf:budget": "node --experimental-strip-types scripts/check-performance-budget.mts",
    "perf:report": "node --experimental-strip-types scripts/check-performance-budget.mts --report-only",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "preview:web": "rsbuild preview",
    "pack:dir": "pnpm build && pnpm asr:verify-real && electron-builder --dir",
    "pack:linux": "pnpm build && pnpm asr:verify-real && electron-builder --linux deb AppImage",
    "pack:windows": "pnpm build && pnpm asr:verify-real && electron-builder --win nsis",
    "pack:mac": "pnpm build && pnpm asr:verify-real && electron-builder --mac dmg",
    "icon:linux:dev": "node --experimental-strip-types scripts/register-linux-dev-launcher.mts",
    "icon:linux:dev:remove": "node --experimental-strip-types scripts/register-linux-dev-launcher.mts --remove",
    "ui:check": "node --experimental-strip-types scripts/check-ui-style-architecture.mts"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@base-ui/react": "^1.9.0",
    "@formkit/auto-animate": "0.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^2.1.0",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.6.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "app.voxnelo.desktop",
    "productName": "Voxnelo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Education",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Voxnelo",
          "Comment": "English speaking practice",
          "StartupWMClass": "app.voxnelo.desktop",
          "Terminal": false,
          "Type": "Application"
        }
      }
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Voxnelo 仅在你主动开始实时听写或录制回听时使用麦克风。本地识别和录音默认不会上传音频。"
      }
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icons/voxnelo.png"
      },
      {
        "from": "build/offline-asr",
        "to": "offline-asr"
      }
    ]
  },
  "desktopName": "app.voxnelo.desktop.desktop"
}
